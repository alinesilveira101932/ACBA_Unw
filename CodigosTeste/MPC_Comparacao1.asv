figure (10)
hold on
grid on; 
check = (A-eye(na))*xbar_opt + B*ubar_opt;
plot (t(1:end-1),check,'linewidth',2)
hold on; box on;
hold on;xlim([0 t(end)])
xlabel('Tempo [s]')
ylabel('check relacao xbar e ubar')


e = zeros(1,size(x{1},2));   % 1 x tempo

for i = 1:na-1
    for j = i+1:na
        e = e + sum(abs(x{i} - x{j}),1);
    end
end

% c1 = sum(u_opt{});

